import random
import math
from dataclasses import dataclass
from enum import Enum

from framework.input.input_manager import InputManager


class GameMode(Enum):
    """7 distinct game modes for progressive cognitive training."""
    MEMORY_STANDARD = "Memory (Standard)"
    MEMORY_BACKWARDS = "Memory (Backwards)"
    SPEED_ATTACK = "Speed Attack"
    ENDURANCE_STANDARD = "Endurance (Standard)"
    ENDURANCE_BACKWARDS = "Endurance (Backwards)"
    MASTER_CHALLENGE = "Master Challenge"
    MASTER_REVERSE_CHALLENGE = "Master Reverse"


class Difficulty(Enum):
    STANDARD = "Standard"
    ADVANCED = "Advanced"
    MASTER = "Master"


BUTTON_SEQUENCE = (
    InputManager.BUTTON_A,      # 0 = Green
    InputManager.BUTTON_B,      # 1 = Red
    InputManager.BUTTON_X,      # 3 = Blue
    InputManager.BUTTON_Y,      # 4 = Yellow
)

BUTTON_LABELS = {
    InputManager.BUTTON_A: "A",
    InputManager.BUTTON_B: "B",
    InputManager.BUTTON_X: "X",
    InputManager.BUTTON_Y: "Y",
}

# Hardware color mapping for cross-fade rendering
BUTTON_COLORS = {
    InputManager.BUTTON_A: (99, 230, 32),      # Green
    InputManager.BUTTON_B: (230, 30, 30),      # Red
    InputManager.BUTTON_X: (30, 136, 230),     # Blue
    InputManager.BUTTON_Y: (245, 197, 0),      # Yellow
}


@dataclass(frozen=True)
class ModeConfig:
    """Configuration for each game mode/difficulty combination."""
    initial_sequence_length: int
    cross_fade_frames: int  # 30 frames = 1 second at 30 FPS
    frame_gap: int  # frames between button flashes
    time_limit: float  # 0 = no timer
    max_rounds: int  # 0 = infinite
    score_step: int
    grows_sequence: bool  # True: sequence +1 per round
    timer_reward_pct: float  # % of remaining time to add back (Endurance/Master modes)


